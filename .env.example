# ===== LLM =====
# 支持: dashscope | openai | deepseek | custom
LLM_PROVIDER=dashscope
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Embedding =====
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # 可选，默认同 LLM
# EMBEDDING_BATCH_SIZE=10             # 每批最大文本数 (1-10)
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_TIMEOUT_SECONDS=60

# ===== Reranker =====
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu               # cpu | cuda
# RERANKER_MODELSCOPE_CACHE_DIR=~/.cache/modelscope  # 本地模型缓存（设置后优先使用）

# ===== Chroma =====
CHROMA_PERSIST_DIR=./data/chroma_data
CHROMA_COLLECTION=knowledge_base

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=agentic_rag

# ===== Upload =====
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ===== Agent =====
AGENT_MAX_ROUNDS=3                 # 最大检索轮数 (1-10)
AGENT_TOP_K_RECALL=20             # 单轮召回数 (1-100)
AGENT_TOP_K_RERANK=5              # 精排后保留数 (1-50)
AGENT_CHUNK_SIZE=800              # 分块大小 (100-4096)
AGENT_CHUNK_OVERLAP=150           # 分块重叠

# ===== Server =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
